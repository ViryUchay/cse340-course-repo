<%- include('partials/header') %>

    <main>
        <section class="content-section">
            <h1>Create New Service Project</h1>

            <% if (errors && errors.length> 0) { %>
                <div class="form-errors" role="alert">
                    <ul>
                        <% errors.forEach((error)=> { %>
                            <li>
                                <%= error %>
                            </li>
                            <% }) %>
                    </ul>
                </div>
                <% } %>

                    <form action="/new-project" method="POST">

                        <div class="form-group">
                            <label for="organization_id">Organization</label>
                            <select id="organization_id" name="organization_id" required>
                                <option value="">Select an organization</option>

                                <% organizations.forEach((organization)=> { %>
                                    <option value="<%= organization.organization_id %>"
                                        <%=Number(project.organization_id)===Number(organization.organization_id)
                                        ? 'selected' : '' %>
                                        >
                                        <%= organization.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="title">Project Title</label>
                            <input type="text" id="title" name="title" value="<%= project.title %>" required
                                maxlength="150">
                        </div>

                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" required><%= project.description %></textarea>
                        </div>

                        <div class="form-group">
                            <label for="location">Location</label>
                            <input type="text" id="location" name="location" value="<%= project.location %>" required
                                maxlength="150">
                        </div>

                        <div class="form-group">
                            <label for="project_date">Project Date</label>
                            <input type="date" id="project_date" name="project_date" value="<%= project.project_date %>"
                                required>
                        </div>

                        <button type="submit" class="btn">Create Project</button>

                        <a href="/projects" class="btn">Cancel</a>

                    </form>
        </section>
    </main>

    <%- include('partials/footer') %>