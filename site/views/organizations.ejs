<%- include('partials/header') %>

<h1><%= title %></h1>
<p class="page-intro">Browse organizations you can volunteer with. Each partners with local communities on ongoing service work.</p>

<section class="card-grid">
  <% organizations.forEach((organization) => { %>
    <article class="card">
      <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
      <p><%= organization.description %></p>
      <p><strong>Contact:</strong> <%= organization.contact_email %></p>
    </article>
  <% }) %>
</section>

<%- include('partials/footer') %>
