
<%- include('partials/header') %>

<main>
    <h1>Categories</h1>

    <% if (isAdmin) { %>
        <p>
            <a href="/new-category" class="btn">Create New Category</a>
        </p>
    <% } %>

    <ul>
        <% categories.forEach((category) => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>