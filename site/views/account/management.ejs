<%- include("../partials/header") %>

    <main class="container">
        <h1>Account Management</h1>

        <% if (typeof successMessages !=="undefined" && successMessages.length> 0) { %>
            <div class="flash-message success" role="status">
                <%= successMessages[0] %>
            </div>
            <% } %>

                <% if (typeof errorMessages !=="undefined" && errorMessages.length> 0) { %>
                    <div class="flash-message error" role="alert">
                        <%= errorMessages[0] %>
                    </div>
                    <% } %>

                        <% if (typeof noticeMessages !=="undefined" && noticeMessages.length> 0) { %>
                            <div class="flash-message" role="status">
                                <%= noticeMessages[0] %>
                            </div>
                            <% } %>

                                <section>
                                    <h2>My Account</h2>

                                    <p>
                                        <strong>Name:</strong>
                                        <%= accountData.account_firstname %>
                                            <%= accountData.account_lastname %>
                                    </p>

                                    <p>
                                        <strong>Email:</strong>
                                        <%= accountData.account_email %>
                                    </p>

                                    <p>
                                        <strong>Account Type:</strong>
                                        <%= accountData.account_type %>
                                    </p>
                                </section>

                                <hr>

                                <section>
                                    <h2>My Volunteer Projects</h2>

                                    <% if (typeof volunteerProjects !=="undefined" && volunteerProjects.length> 0) { %>

                                        <% volunteerProjects.forEach(function(project) { %>
                                            <article class="volunteer-project">
                                                <h3>
                                                    <a href="/project/<%= project.project_id %>">
                                                        <%= project.title %>
                                                    </a>
                                                </h3>

                                                <p>
                                                    <strong>Organization:</strong>
                                                    <%= project.organization_name %>
                                                </p>

                                                <p>
                                                    <strong>Location:</strong>
                                                    <%= project.location %>
                                                </p>

                                                <p>
                                                    <strong>Date:</strong>
                                                    <%= project.project_date %>
                                                </p>

                                                <p>
                                                    <%= project.description %>
                                                </p>

                                                <form action="/project/<%= project.project_id %>/volunteer/remove"
                                                    method="POST">
                                                    <button type="submit">
                                                        Cancel Volunteer Signup
                                                    </button>
                                                </form>
                                            </article>

                                            <hr>
                                            <% }); %>

                                                <% } else { %>
                                                    <p>You have not signed up for any volunteer projects yet.</p>
                                                    <p>
                                                        <a href="/projects">Browse Service Projects</a>
                                                    </p>
                                                    <% } %>
                                </section>

                                <% if (accountData.account_type==="Admin" ) { %>
                                    <hr>

                                    <section>
                                        <h2>Administration</h2>
                                        <p>
                                            <a href="/account/admin">Registered Users</a>
                                        </p>
                                    </section>
                                    <% } %>

                                        <p><a href="/account/logout">Log Out</a></p>
    </main>

    <%- include("../partials/footer") %>