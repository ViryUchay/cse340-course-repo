<%- include('../partials/header') %>

    <main class="container">
        <h1>Register for Service Connect</h1>

        <p>Create an account to participate in community service projects.</p>

        <form action="/account/register" method="POST">
            <div>
                <label for="account_firstname">First Name</label>
                <input type="text" id="account_firstname" name="account_firstname" maxlength="50"
                    autocomplete="given-name" required>
            </div>

            <div>
                <label for="account_lastname">Last Name</label>
                <input type="text" id="account_lastname" name="account_lastname" maxlength="50"
                    autocomplete="family-name" required>
            </div>

            <div>
                <label for="account_email">Email Address</label>
                <input type="email" id="account_email" name="account_email" maxlength="255" autocomplete="email"
                    required>
            </div>

            <div>
                <label for="account_password">Password</label>
                <input type="password" id="account_password" name="account_password" minlength="8"
                    autocomplete="new-password" required>
                <small>Password must contain at least 8 characters.</small>
            </div>

            <button type="submit">Create Account</button>
        </form>

        <p>
            Already registered?
            <a href="/account/login">Log in here</a>.
        </p>
    </main>

    <%- include('../partials/footer') %>