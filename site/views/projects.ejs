<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>
    <div class="card-grid">
        <% projects.forEach(project=> { %>
            <div class="card">
                <h2><a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a></h2>
                <p>by <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a></p>
            </div>
            <% }); %>
    </div>

    <%- include('partials/footer') %>