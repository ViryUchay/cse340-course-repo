
<%- include('partials/header') %>

<main>
    <h1>Service Projects</h1>

    <% if (isAdmin) { %>
        <p>
            <a href="/new-project" class="btn">Create New Service Project</a>
        </p>
    <% } %>

    <p class="intro">
        Explore the service projects available through our partner organizations.
    </p>

    <div class="project-list">
        <% if (projects.length === 0) { %>
            <p>No service projects are currently available.</p>
        <% } else { %>
            <% projects.forEach((project) => { %>
                <article class="project-card">
                    <p class="project-header">
                        <span class="date">
                            <%= new Date(project.project_date).toLocaleDateString('en-GB', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric'
                            }) %>:
                        </span>

                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>

                        <span class="org">
                            (<%= project.organization_name %>)
                        </span>
                    </p>

                    <p class="project-desc"><%= project.description %></p>

                    <p class="project-location">
                        Location: <%= project.location %>
                    </p>
                </article>
            <% }); %>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>