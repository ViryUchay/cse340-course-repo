<%- include('partials/header') %>

  <h1>
    <%= title %>
  </h1>
  <p class="page-intro">Active service projects looking for volunteers right now.</p>

  <section class="card-grid">
    <% projects.forEach((project)=> { %>
      <article class="card">
        <h2>
          <%= project.title %>
        </h2>
        <p>
          <%= project.description %>
        </p>
        <p><strong>Location:</strong>
          <%= project.location %>
        </p>
        <p><strong>Date:</strong>
          <%= project.project_date.toDateString() %>
        </p>
      </article>
      <% }) %>
  </section>

  <%- include('partials/footer') %>