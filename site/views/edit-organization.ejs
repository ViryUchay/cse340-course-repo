<%- include('partials/header') %>

    <main>
        <section class="content-section">
            <h1>Edit Organization</h1>

            <% if (errors && errors.length> 0) { %>
                <div class="form-errors" role="alert">
                    <ul>
                        <% errors.forEach((error)=> { %>
                            <li>
                                <%= error %>
                            </li>
                            <% }) %>
                    </ul>
                </div>
                <% } %>

                    <form action="/edit-organization/<%= organization.organization_id %>" method="POST">

                        <div class="form-group">
                            <label for="name">Organization Name</label>
                            <input type="text" id="name" name="name" value="<%= organization.name %>" required
                                maxlength="150">
                        </div>

                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description"
                                required><%= organization.description %></textarea>
                        </div>

                        <div class="form-group">
                            <label for="contact_email">Contact Email</label>
                            <input type="email" id="contact_email" name="contact_email"
                                value="<%= organization.contact_email %>" required maxlength="255">
                        </div>

                        <div class="form-group">
                            <label for="logo_filename">Logo Filename</label>
                            <input type="text" id="logo_filename" name="logo_filename"
                                value="<%= organization.logo_filename %>" required maxlength="255">
                        </div>

                        <button type="submit" class="btn">Update Organization</button>
                        <a href="/organization/<%= organization.organization_id %>" class="btn">
                            Cancel
                        </a>

                    </form>
        </section>
    </main>

    <%- include('partials/footer') %>