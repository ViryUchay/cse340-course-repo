<%- include("partials/header") %>

    <main class="container">
        <section class="project-details">
            <h1>
                <%= project.title %>
            </h1>

            <p>
                <%= project.description %>
            </p>

            <p>
                <strong>Organization:</strong>
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
            </p>

            <p>
                <strong>Location:</strong>
                <%= project.location %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= project.project_date %>
            </p>

            <% if (typeof isAdmin !=="undefined" && isAdmin) { %>
                <p>
                    <a href="/edit-project/<%= project.project_id %>">
                        Edit Project
                    </a>
                </p>
                <% } %>

                    <hr>

                    <section class="volunteer-section">
                        <h2>Volunteer for This Project</h2>

                        <% if (typeof isLoggedIn !=="undefined" && isLoggedIn) { %>

                            <% if (typeof isVolunteering !=="undefined" && isVolunteering) { %>
                                <p>You have signed up to volunteer for this project.</p>

                                <form action="/project/<%= project.project_id %>/volunteer/remove" method="POST">
                                    <button type="submit">
                                        Cancel Volunteer Signup
                                    </button>
                                </form>

                                <% } else { %>
                                    <p>
                                        Join this project and make a difference in your community.
                                    </p>

                                    <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                                        <button type="submit">
                                            Volunteer for This Project
                                        </button>
                                    </form>
                                    <% } %>

                                        <% } else { %>
                                            <p>
                                                Please <a href="/account/login">log in</a>
                                                to volunteer for this project.
                                            </p>
                                            <% } %>
                    </section>

                    <p>
                        <a href="/projects">Back to Projects</a>
                    </p>
        </section>
    </main>

    <%- include("partials/footer") %>