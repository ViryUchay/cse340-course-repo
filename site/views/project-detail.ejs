<%- include('partials/header') %>

  <article class="content-section">
    <h1>
      <%= project.title %>
    </h1>
    <p>
      <%= project.description %>
    </p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>">
        <%= project.organization_name %>
      </a></p>
    <p><strong>Location:</strong>
      <%= project.location %>
    </p>
    <p><strong>Date:</strong>
      <%= project.project_date.toDateString() %>
    </p>

    <section class="project-tags" aria-labelledby="category-tags-heading">
      <h2 id="category-tags-heading">Categories</h2>
      <% if (categories.length> 0) { %>
        <div class="tags-container">
          <% categories.forEach((category)=> { %>
            <a class="tag-badge" href="/category/<%= category.category_id %>" class="tag-badge">
              <%= category.name %>
            </a>
            <% }) %>
        </div>
        <% } else { %>
          <p>This project does not have category tags yet.</p>
          <% } %>
    </section>
  </article>

  <p><a href="/projects">Back to Service Projects</a></p>

  <%- include('partials/footer') %>